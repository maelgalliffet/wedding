      <span data-i18n="discours.button">[i18n:discours.button]</span>
    </a>
  </div>
</section>

<!-- ── Albums photos ─────────────────────────────────── -->
<section id="photos" class="section section--cta" aria-labelledby="photos-title">
  <div class="section-header fade-up">
    <p class="eyebrow"><a href="#photos" class="section-title-link" data-i18n="albums.eyebrow">[i18n:albums.eyebrow]</a>
    </p>
    <h2 id="photos-title" class="section-title"><a href="#photos" class="section-title-link"
        data-i18n="albums.title">[i18n:albums.title]</a></h2>
    <div class="ornament" aria-hidden="true">
      <svg viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M2,8 C6,2 10,2 12,8 C14,14 18,14 22,8" />
      </svg>
      <svg viewBox="0 0 24 16" fill="currentColor">
        <polygon points="12,2 4,14 20,14" />
        <polygon points="12,2 10,7 14,7" fill="white" />
      </svg>
      <svg viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M2,8 C6,2 10,2 12,8 C14,14 18,14 22,8" />
      </svg>
    </div>
  </div>

  <div class="rsvp-content photos-grid fade-up">
    <a href="https://www.wedshoots.com/fr/download?albumId=FR495d6a8c" target="_blank" rel="noopener noreferrer"
      class="rsvp-btn rsvp-btn--secondary" aria-label="Accéder au album Wedshoots">
      <span>Wedshoots</span>
    </a>
    <a href="https://photos.app.goo.gl/yhrhWo21g6Aw2A8T7" target="_blank" rel="noopener noreferrer"
      class="rsvp-btn rsvp-btn--secondary" aria-label="Accéder à l'album photo mairie">
      <span>Album photo mairie</span>
    </a>
    <a href="https://photos.app.goo.gl/vGRhrGo42UTapDd17" target="_blank" rel="noopener noreferrer"
      class="rsvp-btn rsvp-btn--secondary" aria-label="Accéder à l'album photomaton">
      <span>Album photomaton</span>
    </a>
    <a href="https://photos.app.goo.gl/x62P9MuofXKKf3PDA" target="_blank" rel="noopener noreferrer"
      class="rsvp-btn rsvp-btn--secondary" aria-label="Accéder à l'album des photos du mariage">
      <span>Album photos du mariage</span>
    </a>
  </div>
</section>

<!-- ── Vidéos du mariage ──────────────────────────────── -->
<section id="video" class="section section--video" aria-labelledby="video-title">
  <div class="section-header fade-up">
    <p class="eyebrow"><a href="#video" class="section-title-link" data-i18n="video.eyebrow">[i18n:video.eyebrow]</a>
    </p>
    <h2 id="video-title" class="section-title"><a href="#video" class="section-title-link"
        data-i18n="video.title">[i18n:video.title]</a></h2>
    <div class="ornament" aria-hidden="true">
      <svg viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M2,8 C6,2 10,2 12,8 C14,14 18,14 22,8" />
      </svg>
      <svg viewBox="0 0 24 16" fill="currentColor">
        <polygon points="12,2 4,14 20,14" />
        <polygon points="12,2 10,7 14,7" fill="white" />
      </svg>
      <svg viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M2,8 C6,2 10,2 12,8 C14,14 18,14 22,8" />
      </svg>
    </div>
  </div>

  <div class="videos-grid fade-up">

    <div class="video-item">
      <h3 class="video-item-title" data-i18n="video.teaser.title">[i18n:video.teaser.title]</h3>
      <div class="video-wrap">
        <video class="video-player" controls playsinline preload="metadata"
          aria-label="Teaser du mariage de Salma et Maël">
          <source src="/videos/SalmaMael-WeddingTeaser-EndlessPhotoFilm.mp4" type="video/mp4" />
          Votre navigateur ne prend pas en charge la lecture de vidéos HTML5.
        </video>
      </div>
    </div>

    <div class="video-item">
      <h3 class="video-item-title" data-i18n="video.film.title">[i18n:video.film.title]</h3>
      <div class="video-wrap">
        <video class="video-player" controls playsinline preload="metadata"
          aria-label="Film du mariage de Salma et Maël">
          <source src="/videos/SalmaMael-WeddingFilm-EndlessPhotoFilm.mp4" type="video/mp4" />
          Votre navigateur ne prend pas en charge la lecture de vidéos HTML5.
        </video>
      </div>
    </div>

  </div>
</section>